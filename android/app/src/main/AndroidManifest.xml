<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.jackeyui.anzukipet">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:label="Anzuki 桌寵" android:icon="@drawable/ic_star" android:allowBackup="false"
      android:supportsRtl="true" android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:usesCleartextTraffic="false">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity android:name=".VoiceActivity" android:exported="false" />
    <service android:name=".PetService" android:exported="false" android:stopWithTask="false"
        android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="User-started visible floating character; ongoing notification provides an explicit stop action." />
    </service>
  </application>
</manifest>
